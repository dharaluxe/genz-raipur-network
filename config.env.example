# Selected host: ChatGPT Sites. Store secret keys as encrypted runtime secrets.
GENZ_DATABASE_ENDPOINT=
GENZ_DATABASE_KEY=
GENZ_AUTH_PROVIDER=sites
GENZ_STORAGE_PROVIDER=sites
# Optional external identity/storage mode; not used on the Sites deployment.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Browser-safe public configuration used by the GENZ Supabase UI.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical HTTPS origin used for public Broker ID verification/QR links.
NEXT_PUBLIC_SITE_URL=https://genz-raipur-network.vercel.app
# Used only by the offline import utility, not by hosted Sites.
DATABASE_URL=
# The only verified email allowed to initialize the workspace.
GENZ_OWNER_EMAIL=
GENZ_PUBLIC_VERIFICATION=false
GENZ_LAUNCH_ENABLED=false
